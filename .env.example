# Required for PostgreSQL access. Keep these values aligned across the application.
# The shared database loader prefers DATABASE_URL; the RAG retriever reads DB_*
# directly, so keep both forms pointed at the same database when using the URL.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/novamart
DB_HOST=localhost
DB_PORT=5432
DB_NAME=novamart
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Optional: required only when the OpenAI LLM client is used.
OPENAI_API_KEY=
